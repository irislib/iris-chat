{
  "name": "iris-chat",
  "private": true,
  "version": "2.6.14",
  "type": "module",
  "description": "Decentralized encrypted messaging over Nostr",
  "repository": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/iris-chat",
  "homepage": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/iris-chat",
  "bugs": {
    "url": "https://git.iris.to/#/npub1xdhnr9mrv47kkrn95k6cwecearydeh8e895990n3acntwvmgk2dsdeeycm/iris-chat?tab=issues"
  },
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run verify:dependency-lock && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "pnpm verify:dependency-lock && NODE_OPTIONS=\"--no-warnings --localstorage-file=.vitest-localstorage\" node node_modules/vitest/vitest.mjs run",
    "test:device-sync-interop": "env REQUIRE_DEVICE_SYNC_RUST_INTEROP=1 NODE_OPTIONS=\"--no-warnings --localstorage-file=.vitest-localstorage\" node node_modules/vitest/vitest.mjs run src/lib/deviceSyncRustInterop.test.ts",
    "verify:dependency-lock": "node scripts/verify-dependency-lock.mjs",
    "test:watch": "NODE_OPTIONS=\"--no-warnings --localstorage-file=.vitest-localstorage\" node node_modules/vitest/vitest.mjs",
    "test:e2e": "env -u NO_COLOR playwright test",
    "smoke:portable": "node ./scripts/smoke-iris-chat-portable.mjs",
    "publish:iris": "node ./scripts/publish-iris-build.mjs",
    "release:iris": "node ./scripts/release-site.mjs"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.24",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@unocss/preset-icons": "^66.7.5",
    "@unocss/preset-uno": "^66.7.5",
    "@unocss/transformer-directives": "^66.7.5",
    "jsdom": "^26.1.0",
    "svelte": "^5.56.5",
    "svelte-check": "^4.7.3",
    "typescript": "~5.9.3",
    "unocss": "^66.7.5",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "ws": "^8.21.1"
  },
  "dependencies": {
    "@fips/core": "https://github.com/mmalmi/fips-ts/releases/download/runtime-v0.0.26/fips-core-0.0.26.tgz",
    "@fips/tcp": "https://github.com/mmalmi/fips-tcp/releases/download/v0.2.0/fips-tcp-0.2.0.tgz",
    "@fips/transport-webrtc": "https://github.com/mmalmi/fips-ts/releases/download/runtime-v0.0.26/fips-transport-webrtc-0.0.42.tgz",
    "@hashtree/core": "https://github.com/mmalmi/hashtree/releases/download/hashtree-ts-runtime-v0.5.0/hashtree-core-0.3.0.tgz",
    "@noble/hashes": "^2.2.0",
    "@noble/secp256k1": "^3.1.0",
    "@nostr-dev-kit/ndk": "^2.18.1",
    "dexie": "^4.4.4",
    "dompurify": "^3.4.12",
    "jsqr": "^1.4.0",
    "marked": "^15.0.12",
    "minidenticons": "^4.2.1",
    "nostr-double-ratchet": "https://github.com/irislib/nostr-double-ratchet/releases/download/nostr-double-ratchet-ts-v0.0.165/nostr-double-ratchet-0.0.165.tgz",
    "nostr-pubsub": "https://github.com/mmalmi/nostr-pubsub/releases/download/nostr-pubsub-ts-v0.3.0/nostr-pubsub-0.3.0.tgz",
    "nostr-tools": "^2.23.12",
    "qrcode": "^1.5.4"
  }
}
